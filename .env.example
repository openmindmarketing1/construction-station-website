NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Open Mind Marketing — public blog feed. Posts published in the OMM admin
# trigger this site's Vercel Deploy Hook; each rebuild then pulls the latest
# posts from the feed below and merges them with the hand-built /blog index.
NEXT_PUBLIC_OMM_API_URL=https://openmindmarketing.ai
NEXT_PUBLIC_OMM_BUSINESS_ID=

# Cloudflare Turnstile site key (public) for the lead forms' bot check —
# src/lib/bot-guard.tsx. The matching secret lives only in OMM's Vercel env
# (TURNSTILE_SECRET_KEY). Unset = no widget; the hidden field still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
